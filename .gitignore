.Rhistory
.RData
.Rproj.user/
__pycache__/
*.pyc
.DS_Store

# Source documents are mirrored locally, not committed: roughly 1 GB of PDFs.
# Rebuild with the download scripts; checksums of every file read are recorded
# in data/processed/*_source_manifest.json and data/raw/bsc/bsc_pdf_manifest.json.
data/raw/cbl/
data/raw/cbl_fx/
data/raw/bsc/pdf/

# Reference geography re-downloaded by scripts/download_hdx_codab.sh. Not
# committed: COD-AB is CC BY-IGO and the OSM extract is ODbL.
data/raw/hdx/

# HNEC source PDFs, re-downloadable by scripts/download_hnec.py. Checksums are
# recorded in the manifest beside each directory.
data/raw/hnec/polling_centres/
data/raw/hnec/municipal_2025/
data/raw/hnec/card_distribution/

# OpenSanctions bulk collections, 1.3 GB of global FollowTheMoney entities,
# re-downloadable by scripts/download_opensanctions.py. Upstream SHA-1 and local
# SHA-256 of every file are recorded in data/raw/opensanctions/manifest.json.
data/raw/opensanctions/*.json
!data/raw/opensanctions/manifest.json

# Official Gazette issues, re-downloadable by scripts/download_gazette.py.
# SHA-256 of every issue is recorded in data/raw/gazette/manifest.json.
data/raw/gazette/*.pdf
